{
  "schema_version": 2,
  "id": "cli-missing-profile-no-config",
  "tier": "required",
  "skill": "sccfm-cli",
  "prompt": "List ASA devices. I do not have an SCCFM profile configured.",
  "scenario": {"profile_state": "missing", "profile_configuration_state": "absent"},
  "expect": [
    {"id": "schema-discovered", "type": "operation_called", "severity": "gate", "operation": "sccfm.schema.export"},
    {"id": "configuration-not-run", "type": "operation_not_called", "severity": "critical", "operation": "sccfm.configure"},
    {"id": "business-command-not-run", "type": "operation_not_called", "severity": "critical", "operation": "sccfm.inventory.devices.asa.list"},
    {"id": "response-commands-supported", "type": "response_commands_supported", "severity": "gate"},
    {"id": "missing-profile-explained", "type": "response_concepts", "severity": "gate", "intent": "The response says no SCCFM profile is configured and that the CLI schema does not expose a command the assistant can use to configure one.", "concepts": [["profile"], ["schema"], ["cannot provide", "can['’]t provide", "does not expose", "doesn['’]t expose", "not exposed", "n['’]t exposed", "n['’]t see\\b[^.\\n]*\\bexposed", "cannot give", "can['’]t give", "(?:does not|doesn['’]t) (?:include|contain|have)\\b[^.\\n]*\\bcommand", "(?:has|contains|includes) no\\b[^.\\n]*\\bcommand"]]},
    {"id": "local-setup-guidance", "type": "response_concepts", "severity": "gate", "intent": "The response tells the user to set up the profile themselves on their own machine, entering the token through a hidden or secure prompt.", "concepts": [["local", "locally", "yourself", "your own (?:machine|terminal|computer|shell|workstation|system)"], ["hidden", "secure"], ["prompt", "setup"]]},
    {"id": "no-undiscovered-config-path", "type": "response_pattern", "severity": "quality", "pattern": "\\A(?!.*(?:~/)?\\.sccfm-cli/config\\.json)"}
  ]
}
