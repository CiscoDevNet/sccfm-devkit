{
  "schema_version": 2,
  "id": "cli-readonly-generate-only",
  "tier": "aspirational",
  "skill": "sccfm-cli",
  "prompt": "Show me the exact sccfm-cli command to list ASA devices from the default profile. Do not run the device list; I will run it myself.",
  "expect": [
