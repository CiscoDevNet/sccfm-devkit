# Copy this file to .env and fill in your values
# The .env file is gitignored and loaded automatically by direnv

# SCCFM region: int (staging), us, eu, apj, aus, uae, in, ci
export SCCFM_REGION=int

# Your SCCFM API token (get from SCCFM UI > Settings > API Tokens)
export SCCFM_API_TOKEN="your-api-token-here"
