{
  "description": "Codex compatibility SCCFM command gate. Keep this policy aligned with hooks/hooks.json.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/sccfm_guard.py --record-plan",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/sccfm_guard.py --record-approval",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/sccfm_guard.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
